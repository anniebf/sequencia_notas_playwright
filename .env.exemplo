# Credenciais do banco usadas para buscar os CNPJs.
usernameBd = rpa
passwordBd= senha
dsn = exemplo.bomfuturo.local:0000/exemplo
dsnhomol = exemplo.bomfuturo.local:0000/exemplo

# Credenciais do portal. Podem ser usadas no container sem montar params.json.
CONTABILISTA=SEU_CONTABILISTA
SENHA_CONTABILISTA=SUA_SENHA

# Chave do Anti-Captcha .
ANTI_CAPTCHA_TOKEN=""

# Diretorio montado no Docker que contem este .env e params.json.
CONFIG_DIR=/config

# Caminho do JSON dentro do volume de configuracao.
SEQUENCIA_NOTAS_PARAMS=/config/params.json

# Copia opcional dos CSVs para a pasta de producao.
SEQUENCIA_NOTAS_PRODUCAO=

# Execucao headless por padrao. Use false para acompanhar o navegador.
SEQUENCIA_NOTAS_HEADLESS=true
